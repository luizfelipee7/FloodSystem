[Unit]
Description=FloodSystem FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=floodsystem
Group=floodsystem
WorkingDirectory=/srv/floodsystem
EnvironmentFile=/etc/floodsystem/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/srv/floodsystem/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/srv/floodsystem/database

[Install]
WantedBy=multi-user.target
