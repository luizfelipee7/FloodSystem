# Copy to /etc/floodsystem/api.env on the VM with mode 0640, root:floodsystem.
# Generate the real token on the VM; never put it in this example or the frontend.
FLOODSYSTEM_ENV=production
FLOODSYSTEM_DB_PATH=/srv/floodsystem/database/production.db
FLOODSYSTEM_DEVICE_TOKENS_JSON='{"esp32-01":"REPLACE_WITH_A_RANDOM_PRIVATE_TOKEN_AT_LEAST_32_CHARACTERS"}'
