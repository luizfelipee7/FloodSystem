# Modelo documental: esta etapa lê variáveis do processo, sem carregar .env automaticamente.
FLOODSYSTEM_ENV=development
FLOODSYSTEM_DB_PATH=database/development.db
FLOODSYSTEM_TEST_DB_PATH=database/test.db
# Caminhos relativos são resolvidos a partir da raiz do projeto, não da pasta do terminal.
# H0 e K não possuem valores padrão. Calibrações são cadastradas e versionadas no SQLite.
# Em produção, a autenticação de escrita é obrigatória e exige tokens exclusivos.
# Configure FLOODSYSTEM_DEVICE_TOKENS_JSON no ambiente privado do servidor.
# Exemplo de formato sem credenciais: {"esp32-01":"<token-aleatorio-com-pelo-menos-32-caracteres>"}
# FLOODSYSTEM_REQUIRE_DEVICE_AUTH=true
