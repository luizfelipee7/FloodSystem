# Proxy usado pelo servidor local Vite. Reinicie-o após alterar.
API_PROXY_TARGET=http://127.0.0.1:8000
# API exclusiva de ensaios, usada por /article-api no Vite local.
ARTICLE_API_PROXY_TARGET=http://127.0.0.1:8010
# As chamadas do navegador usam a mesma origem por padrão.
# Se apontar diretamente a outra origem, ela deverá permitir CORS.
VITE_API_BASE_URL=
# A aba de ensaios só aparece quando habilitada para este build/site local.
VITE_EXPERIMENTS_ENABLED=false
# Opcional: dispositivo inicial do monitoramento. Vazio usa o padrão do build.
VITE_DEFAULT_DEVICE_ID=
